# Ignore every ~/.config entry unless it is explicitly allowlisted below.
/*

!/.gitignore
!/README.md

!/packages/
!/packages/**

!/btop/
!/btop/**
!/cava/
!/cava/**
!/doom/
!/doom/**
!/fuzzel/
!/fuzzel/**
!/gtk-3.0/
!/gtk-3.0/**
!/gtk-4.0/
!/gtk-4.0/**
!/hypr/
!/hypr/**
!/kitty/
!/kitty/**
!/nvim/
!/nvim/**
!/swaync/
!/swaync/**
!/swayosd/
!/swayosd/**
!/waybar/
!/waybar/**
!/wlogout/
!/wlogout/**

# Runtime and temporary files inside tracked directories.
*.log
*.swp
*.tmp
*~
**/.git/
**/.agents
**/.agents/**
**/.codex
**/.codex/**
**/.lazy/
**/.mason/
